# GlaucoMap API Server — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env.

# Required for RNFL extraction from OCT images
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: override the model (default: gpt-4o-mini)
# Use gpt-4o for best accuracy on small/blurry reports
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: override the API server port (default: 3001)
# API_PORT=3001

# ==============================================================================
# GlaucoMap - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_USER=glaucomap
POSTGRES_PASSWORD=glaucomap_dev_password
POSTGRES_DB=glaucomap_db
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+psycopg2://glaucomap:glaucomap_dev_password@localhost:5432/glaucomap_db

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# CORS Allowed Origins (JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ML Model & Storage Paths (Future)
MODEL_STORAGE_PATH=./models
DATA_STORAGE_PATH=./data
DEVICE=cpu
